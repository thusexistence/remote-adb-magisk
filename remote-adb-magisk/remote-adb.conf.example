# Copy this file to /data/adb/remote-adb.conf and chmod 600.
# Never commit your real copy to a public repository.
WIFI_SSID='GPY.AI_5G'
WIFI_SECURITY='wpa2'
WIFI_PASSWORD='YOUR_WIFI_PASSWORD'
WIFI_BSSID=''

# Optional receiver on the same LAN. Leave empty to disable reporting.
REPORT_HOST='192.168.1.207'
REPORT_PORT='39393'
REPORT_INTERVAL='20'

WIFI_AUTOCONNECT_WAIT='60'
WIFI_CONNECT_WAIT='120'
WIFI_RETRY_DELAY='15'
WIFI_POLL_INTERVAL='2'
